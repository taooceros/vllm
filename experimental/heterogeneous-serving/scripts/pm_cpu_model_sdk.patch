+def _require_real_distributed_state(operation: str) -> None:
+    if _cpu_model_parallel_geometry.get() is not None:
+        raise RuntimeError(
+            f"{operation} is unavailable inside cpu_model_parallel_geometry: "
+            "only static TP/PP scalar metadata queries are supported; "
+            "real groups, communication and native initialization are not."
+        )
+
+
+@contextmanager
+def cpu_model_parallel_geometry(
+    tp_rank: int,
+    tp_size: int,
+    pp_rank: int = 0,
+    pp_size: int = 1,
+) -> Iterator[None]:
+    """Supply static TP/PP metadata for CPU-only model construction.
+
+    This is not distributed initialization: no group is created or returned,
+    and model_parallel_is_initialized() remains false. Existing distributed
+    state and nested geometry contexts are rejected. State is context-local
+    and restored even when construction raises.
+
+    This context allocates no tensors and does not initialize any device. It
+    does not change tensor placement or sandbox arbitrary constructor code:
+    the caller must separately use torch.device("meta") and native/allocation
+    guards when constructing a storage-free model. Communication, execution,
+    and concurrent distributed initialization are outside this contract.
+    """
+    for name, rank, size in (
+        ("tp", tp_rank, tp_size),
+        ("pp", pp_rank, pp_size),
+    ):
+        if type(rank) is not int or type(size) is not int:
+            raise TypeError(f"{name}_rank and {name}_size must be integers")
+        if size < 1 or not 0 <= rank < size:
+            raise ValueError(f"require {name}_size >= 1 and 0 <= {name}_rank < size")
+    if _cpu_model_parallel_geometry.get() is not None:
+        raise RuntimeError("cpu_model_parallel_geometry cannot be nested")
+    if (
+        torch.distributed.is_initialized()
+        or any(
+            group is not None
+            for group in (
+                _WORLD, _INNER_DP_WORLD, _TP, _PP, _DP, _EP, _EPLB, _DCP, _PCP
+            )
+        )
+        or any(group_ref() is not None for group_ref in _groups.values())
+    ):
+        raise RuntimeError(
+            "cpu_model_parallel_geometry requires no existing distributed groups"
+        )
+    token = _cpu_model_parallel_geometry.set(
+        _CPUModelParallelGeometry(tp_rank, tp_size, pp_rank, pp_size)
+    )
+    try:
+        yield
+    finally:
+        _cpu_model_parallel_geometry.reset(token)
